   "webhookId": "019bda6b-d789-4c6d-89a0-b04958f21d7a"
  },
  {
   "id": "c569fc6e-f513-4978-8e1a-95c5c18f6de8",
   "name": "Procura existente",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.8,
   "position": [
    780,
    0
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT c.id, c.nome, c.ativo FROM (SELECT 1) x LEFT JOIN contacts c ON substr(c.numero,3,2) = substr($1,3,2) AND right(c.numero,8) = right($1,8) LIMIT 1",
    "options": {
     "queryReplacement": "={{ [$json.numero] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "cred-wa-db",
     "name": "wa-db"
    }
   }
  },
  {
   "id": "ddca1fca-033e-455b-885e-8391642c10dc",
   "name": "Decide",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1040,
    0
   ],
   "parameters": {
    "jsCode": "\nconst v = $('Valida número').first().json, e = $input.first().json;\nconst tel = '+' + v.numero.slice(0, 2) + ' ' + v.numero.slice(2, 4) + ' ' + v.numero.slice(4, -4) + '-' + v.numero.slice(-4);\nif (e.id == null) return [{json: {...v, novo: true, titulo: 'Contato cadastrado ✅',\n  mensagem: `${v.nome} (${tel}) foi cadastrado no grupo “${v.grupo}”. A mensagem de boas-vindas será enviada em alguns minutos, respeitando o espaçamento entre envios.`}}];\nif (e.ativo === false) return [{json: {...v, novo: false, titulo: 'Contato já existe (descadastrado)',\n  mensagem: `O número ${tel} já está cadastrado como “${e.nome}”, mas foi DESCADASTRADO. Ele NÃO foi reativado e nenhuma mensagem foi enviada. Para reativar, use a página Contatos e descadastro.`}}];\nreturn [{json: {...v, novo: false, titulo: 'Contato já cadastrado',\n  mensagem: `O número ${tel} já está cadastrado como “${e.nome}”. Nada foi alterado e nenhuma mensagem foi enviada.`}}];\n"
   }
  },
  {

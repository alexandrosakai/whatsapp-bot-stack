   ],
   "parameters": {
    "authentication": "basicAuth",
    "formTitle": "Cadastrar contato",
    "formDescription": "Cadastre quem vai receber os avisos automáticos e poderá conversar com o assistente.",
    "formFields": {
     "values": [
      {
       "fieldLabel": "Nome",
       "requiredField": true
      },
      {
       "fieldLabel": "WhatsApp (com DDD)",
       "requiredField": true,
       "placeholder": "11999998888"
      },
      {
       "fieldLabel": "Grupo",
       "requiredField": false,
       "placeholder": "geral"
      }
     ]
    },
    "responseMode": "onReceived",
    "options": {
     "path": "cadastrar",
     "buttonLabel": "Cadastrar",
     "appendAttribution": false
    }
   },
   "webhookId": "9c822192-afe4-4908-ab05-0f13ddc16565",
   "credentials": {
    "httpBasicAuth": {
     "id": "cred-form-auth",
     "name": "form-auth"
    }
   }
  },
  {
   "id": "cfb790b3-8e95-4335-bfc7-18ca16a41096",
   "name": "Valida número",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    260,
    0
   ],
   "parameters": {
    "jsCode": "\nconst j = $input.first().json;\nlet n = String(j['WhatsApp (com DDD)'] || '').replace(/\\D/g, '');\nif (n.length === 10 || n.length === 11) n = '55' + n;\nconst nome = String(j['Nome'] || '').trim().replace(/\\s+/g, ' ');\nconst base = {nome, numero: n, grupo: String(j['Grupo'] || 'geral').trim().toLowerCase() || 'geral'};\nif (!nome) return [{json: {...base, valido: false, erro: 'Informe o nome do contato.'}}];\nif (!/^55\\d{10,11}$/.test(n)) return [{json: {...base, valido: false, erro: 'Número inválido. Informe DDD + número, por exemplo 11999998888.'}}];\nreturn [{json: {...base, valido: true, texto: `Olá, ${nome.split(' ')[0]}! Você foi cadastrado para receber avisos automáticos da Empresa Exemplo neste número. 😊`}}];\n"
   }
  },
  {
   "id": "cbf72bd7-b200-4a43-bebe-0df9fe2e9c57",
   "name": "Dados válidos?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    520,
    0
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "strict",
      "version": 2
     },
     "conditions": [
      {
       "id": "b5af0ba8-c4e1-4639-94ae-12ff09c8d8ba",
       "leftValue": "={{ $json.valido }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "id": "6f866567-c346-411a-8fee-f73bf0959ab3",
   "name": "Fim - inválido",
   "type": "n8n-nodes-base.form",
   "typeVersion": 2.5,
   "position": [
    780,

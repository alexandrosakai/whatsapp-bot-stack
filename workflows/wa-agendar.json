  {
   "id": "658f798b-3f4e-4c66-b478-bb73917a0bbc",
   "name": "Conta destinatários",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.8,
   "position": [
    780,
    0
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT count(*)::int AS qtd FROM contacts c WHERE c.ativo AND (lower($1)='todos' OR lower(c.grupo)=lower($1) OR c.numero = ANY(string_to_array(regexp_replace($1,'[^0-9,]','','g'),',')))",
    "options": {
     "queryReplacement": "={{ [$json.destino] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "cred-wa-db",
     "name": "wa-db"
    }
   }
  },
  {
   "id": "a9ea4237-3f65-4773-84c5-1322c1986ac6",
   "name": "Decide",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1040,
    0
   ],
   "parameters": {
    "jsCode": "\nconst p = $('Prepara').first().json, q = $input.first().json.qtd;\nconst [d, h] = p.quando.split('T'), [a, m, dia] = d.split('-');\nconst quando = `${dia}/${m}/${a} às ${h}`;\nif (!q) return [{json: {...p, enviar: false, tituloFim: 'Nenhum destinatário encontrado',\n  mensagem: `Nenhum contato ativo corresponde a “${p.destino}”. Use “todos”, o nome de um grupo existente, ou os números completos (com 55 e DDD) separados por vírgula. Nada foi agendado.`}}];\nreturn [{json: {...p, enviar: true, tituloFim: 'Mensagem agendada ✅',\n  mensagem: `“${p.titulo}” será enviada em ${quando} para ${q} contato(s) (${p.destino}). Repetição: ${p.repete}. Os envios saem um de cada vez, com intervalo entre eles, dentro da janela configurada.`}}];\n"
   }
  },
